#!name=中国移动签到
#!desc=中国移动 App「签到有礼」每日自动签到 + 累计/连签奖励自动领取。凭证用抓包获取（见 README.md）。
#!author=Muse
#!homepage=https://wx.10086.cn
#!arguments=account,checkin_hour:9,checkin_minute:0,keepalive:true,capture:true
#!arguments-desc=凭证：打开 App 签到页时由抓包脚本自动抓取并保存，不用填。抓不到时把 appTokenLogin 请求体 JSON 粘贴到 account（JSON 里若含 & 请改用 BoxJS）。签到时间：checkin_hour（0-23，默认 9）和 checkin_minute（0-59，默认 0）。keepalive：每小时保活一次，重置 app_token 的 2 小时过期计时（默认开）。capture：抓包开关（默认开）。

# 使用前必读（见 README.md）：
# 1. 脚本地址已指向本仓库的 cmcc.js / cmcc-capture.js：
#    https://cdn.jsdelivr.net/gh/JiuYueQingCheng/cmcc-surge-checkin@main/cmcc.js
#    https://cdn.jsdelivr.net/gh/JiuYueQingCheng/cmcc-surge-checkin@main/cmcc-capture.js
#    直接导入本模块即可，不用改 script-path。
# 2. 凭证不在文件里填：安装模块后，打开中国移动 App → 我的 → 签到有礼，
#    等页面加载完，收到「✅ 中国移动凭证已更新」通知即完成抓取。
#    App 若做证书 pinning 抓不到，请用 Stream/Proxyman 手动抓包，
#    把 appTokenLogin 请求体 JSON 粘贴到模块参数 account 或 BoxJS（键 cmcc_account）。
# 3. app_token 服务端约 2 小时过期：模块每小时自动保活一次（keepalive），
#    只要 App 不退出登录、不被踢下线，凭证可长期自续。App 退出登录后须重新抓包。
# 4. 启用模块后每天在设定时间自动签到（默认 09:00），并自动领取累计/连签奖励。
#
# 注意：模块参数表需要较新版 Surge（Mac 5.5.0+ 起支持，iOS 也需较新版）。
# 旧版 Surge 会忽略 #!arguments，那时请改用 BoxJS（键 cmcc_account）。

[Script]
中国移动签到 = type=cron,cronexp="{{{checkin_minute}}} {{{checkin_hour}}} * * *",script-path=https://cdn.jsdelivr.net/gh/JiuYueQingCheng/cmcc-surge-checkin@main/cmcc.js,argument=mode=checkin&account={{{account}}}
中国移动保活 = type=cron,cronexp="0 * * * *",script-path=https://cdn.jsdelivr.net/gh/JiuYueQingCheng/cmcc-surge-checkin@main/cmcc.js,argument=mode=keepalive&keepalive={{{keepalive}}}&account={{{account}}}
中国移动凭证抓取 = type=http-request,pattern=^https://wx\.10086\.cn/qwhdsso/appTokenLogin,script-path=https://cdn.jsdelivr.net/gh/JiuYueQingCheng/cmcc-surge-checkin@main/cmcc-capture.js,argument=capture={{{capture}}},requires-body=true

[MITM]
hostname = wx.10086.cn
